{% extends "base.html.j2" %}
{% from "macros.html.j2" import entry, education, skills %}
{% block content %}
<header class="page-head">
  <p class="eyebrow">Experience</p>
  <h1>Teaching, education &amp; skills</h1>
</header>

<section class="block" id="teaching">
  <h2 class="label">Past professional experience</h2>
  {%- for e in experience %}
  {{ entry(e) }}
  {%- endfor %}
</section>

<section class="block" id="education">
  <h2 class="label">Education</h2>
  {{ education(cv_education) }}
</section>

<section class="block" id="skills">
  <h2 class="label">Skills</h2>
  {{ skills(cv_skills) }}
</section>
{% endblock %}
