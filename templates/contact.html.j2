{% extends "base.html.j2" %}
{% block content %}
<header class="page-head">
  <h1>Contact</h1>
  <p class="summary">Email is the best way to reach me.</p>
</header>

<dl class="contact-list">
  <div class="contact-row">
    <dt>Email</dt>
    <dd><a href="mailto:{{ person.email }}">{{ person.email }}</a></dd>
  </div>
  {%- if person.institutional_email %}
  <div class="contact-row">
    <dt>Institutional email</dt>
    <dd><a href="mailto:{{ person.institutional_email }}">{{ person.institutional_email }}</a></dd>
  </div>
  {%- endif %}
  <div class="contact-row">
    <dt>Affiliation</dt>
    <dd>{{ person.role }} · {{ person.field }}<br>{{ person.institution }}<br><span class="muted">{{ person.location }}</span></dd>
  </div>
  {%- for p in profiles %}
  <div class="contact-row">
    <dt>{{ p.name }}</dt>
    <dd><a href="{{ p.url }}" target="_blank" rel="me noopener noreferrer"><img src="{{ p.icon }}" alt="" />{{ p.url.split("://")[1].split("&")[0].replace("www.", "", 1).rstrip("/") }}</a></dd>
  </div>
  {%- endfor %}
</dl>
{% endblock %}
