<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% if page_title %}{{ page_title }} · {% endif %}{{ person.first_name }} {{ person.last_name }}, Ph.D.</title>
  <meta name="description" content="{{ description or person.role ~ ' · ' ~ person.field ~ ' · ' ~ person.institution }}" />
  {%- if noindex %}
  <meta name="robots" content="noindex" />
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300;0,8..60,400;0,8..60,600;1,8..60,300;1,8..60,400&family=DM+Mono:wght@300;400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" href="{{ root }}static/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="{{ root }}static/apple-touch-icon.png" />
  <link rel="stylesheet" href="{{ root }}static/style.css" />
  <script>
    // Light is the default; dark only when chosen with the toggle.
    try { if (localStorage.getItem('theme') === 'dark') document.documentElement.dataset.theme = 'dark'; } catch (e) {}
  </script>
</head>
<body class="page-{{ page }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrapper bar">
      <a class="brand" href="{{ root }}index.html">{{ person.first_name }} {{ person.last_name }}<span class="period">.</span></a>
      <div class="bar-right">
      <nav aria-label="Main">
        <ul>
          {%- for slug, label in nav %}
          <li><a href="{{ root }}{{ slug }}.html"{% if slug == page %} aria-current="page"{% endif %}>{{ label }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      <button type="button" class="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      </div>
    </div>
  </header>

  <main id="main" class="wrapper">
{% block content %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="wrapper">
      <span>© {{ year }} {{ person.full_name }}</span>
      <span>{{ person.institution }} · <a href="mailto:{{ person.email }}">{{ person.email }}</a></span>
    </div>
  </footer>
<script>
  document.querySelector('.theme-toggle').addEventListener('click', () => {
    const root = document.documentElement;
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
</script>
{% block scripts %}{% endblock %}
</body>
</html>
